#!/bin/sh

# Target lock file used to prevent redundant execution
LOCK_FILE="/var/run/qos_hotplug.lock"
DELAY_SECONDS="3"

if echo "$DEVICE" | grep -q "tun"; then
    case "$ACTION" in
        ifup|ifdown)
            # Check if there is already a waiting lock
            if [ -f "$LOCK_FILE" ]; then
                # A new tun interface is created while we are waiting, reset the timestamp
                touch "$LOCK_FILE"
                exit 0
            fi

            # Create the lock file
            touch "$LOCK_FILE"

            # Run in background to avoid blocking the main Hotplug pipeline
            (
                # Loop to wait until no new tun interfaces are appearing/disappearing
                while true; do
                    # Check the age of the lock file (in seconds)
                    LAST_MOD=$(stat -c %Y "$LOCK_FILE")
                    NOW=$(date +%s)
                    AGE=$((NOW - LAST_MOD))

                    if [ "$AGE" -ge "$DELAY_SECONDS" ]; then
                        # No new tun activity for the last 5 seconds, safe to trigger QoS
                        /etc/init.d/qos restart
                        rm -f "$LOCK_FILE"
                        break
                    fi
                    
                    # Sleep for a short interval before re-checking
                    sleep 1
                done
            ) &
            ;;
    esac
fi
