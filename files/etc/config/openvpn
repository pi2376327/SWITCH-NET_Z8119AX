config openvpn 'client'
        option enabled '0'
        list remote 'ovpn.switch-net.com'
        #list remote '183.60.61.156'
        #list remote '121.14.71.180'
        option port '1199'
        option dev 'tun0'
        option nobind '1'
        option verb '3'
        option client '1'
        option log '/var/log/openvpn.log'
        option up '/etc/openvpn/openvpn-up.sh'
        option down '/etc/openvpn/openvpn-down.sh'
        option script_security '2'
        option persist_tun '1'
        option persist_key '1'
        option pull '1'
        option proto 'tcp-client'
        option resolv_retry 'infinite'
        option auth_user_pass '/etc/openvpn/userpass.txt'
        option cipher 'AES-128-GCM'
        option auth_nocache '1'
        option reneg_sec '0'
        option remote_cert_tls 'server'
        option ca '/etc/openvpn/ca.crt'
        option tun_mtu '1470'
        option route_nopull '1'

