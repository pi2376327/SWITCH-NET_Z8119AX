config openvpn 'server'
        option enabled '0'
        option mode 'server'
        option topology 'subnet'
        option local '0.0.0.0'
        option dev 'tun10'
        option port '1199'
        option proto 'tcp-server'
        option server '10.0.100.0 255.255.255.0'
        list push 'redirect-gateway'
        list push 'dhcp-option DNS 10.0.100.1'
        list push 'dhcp-option DNS 8.8.8.8'
        option dh '/etc/openvpn/dh.pem'
        option key '/etc/openvpn/server.key'
        option cert '/etc/openvpn/server.crt'
        option ca '/etc/openvpn/ca.crt'
        option verb '3'
        option keepalive '10 60'
        option client_to_client '1'
        option max_clients '100'
        option username_as_common_name '1'
        option verify_client_cert 'none'
        option client_config_dir '/etc/openvpn/ccd'
        option reneg_sec '0'
        option tun_mtu '1400'
        option persist_tun '1'
        option persist_key '0'
        option log '/var/log/openvpn.log'
        option status '/etc/openvpn/openvpn-status.log 10'
        option status_version '1'
        option mute '10'
        option comp_lzo 'no'
        option script_security '3'
        option auth_user_pass_verify '/etc/openvpn/checkpsw.sh via-env'

