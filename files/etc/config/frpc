
config init
        option stdout '1'
        option stderr '1'
        option user 'root'
        option group 'root'
        option respawn '1'

config conf 'common'
        option server_addr '14.152.34.150'
        option server_port '7200'
        option log_file '/var/log/frpc.log'
        option log_level 'error'
        option token 'switch-net.com'
        option user 'Default'
        option login_fail_exit 'false'
        option protocol 'tcp'
        option tls_enable 'false'

config conf 'ssh'
        option name 'ssh'
        option type 'tcp'
        option local_ip '127.0.0.1'
        option local_port '11199'
        option remote_port '1199'
        option use_encryption 'false'
        option use_compression 'false'

