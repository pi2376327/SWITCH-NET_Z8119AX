# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

#ipset start with system
ipset create chnroute hash:net
ipset restore -f /root/script/chnroute-ipset

#start rtty-client
/etc/init.d/rtty start

#ip rule for REDIRECT all oversea traffic
#ip route add local 0.0.0.0/0 dev lo table 300
#ip rule add fwmark 2 table 300 

#Install Nexttrace
#wget -O /usr/bin/nexttrace https://github.com/nxtrace/NTrace-core/releases/download/v1.7.1/nexttrace_linux_arm64 && chmod +x /usr/bin/nexttrace 

exit 0
